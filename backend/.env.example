DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5174

MYSQL_DATABASE=prompt_generator
MYSQL_USER=prompt_user
MYSQL_PASSWORD=replace-this-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 正式环境推荐保留数据库配置后端，随后可在 Django 后台“部署配置”中填写 SMTP。
EMAIL_BACKEND=content.email_backend.DatabaseConfiguredEmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@example.com
FEEDBACK_NOTIFICATION_EMAIL=admin@example.com
DJOSER_DOMAIN=127.0.0.1:5174
SITE_NAME=图片提示词生成器

# Cloudflare R2：用于头像、模板预览、意见附件和后台替换图片。
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.example.com
