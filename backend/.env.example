DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5174

MYSQL_DATABASE=prompt_generator
MYSQL_USER=prompt_user
MYSQL_PASSWORD=replace-this-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Development defaults to console mail. Replace these values for real activation emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@example.com
FEEDBACK_NOTIFICATION_EMAIL=admin@example.com
DJOSER_DOMAIN=127.0.0.1:5174
SITE_NAME=图片提示词生成器
